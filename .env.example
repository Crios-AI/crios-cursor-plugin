# Local process only, and only if you start mcp/server.mjs yourself.
# In Cursor, set Crios personal access token under Plugins → Configure.
# Do not put a real token in this file. The REST client defaults to https://api.crios.ai.
# The product home is https://crios.ai. The MCP server is https://mcp.crios.ai/mcp.
#
# CRIOS_BASE_URL=https://api.crios.ai
# CRIOS_TOKEN=crios_pat_replace_me
