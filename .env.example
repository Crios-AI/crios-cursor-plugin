# Local process only, and only if you start mcp/server.mjs yourself.
# In Cursor, set Crios personal access token and Crios base URL under Plugins → Configure.
# Do not put a real token in this file. CRIOS_BASE_URL defaults to https://crios.ai.
#
# CRIOS_BASE_URL=https://crios.ai
# CRIOS_TOKEN=crios_pat_replace_me
